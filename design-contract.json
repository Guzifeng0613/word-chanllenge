{
  "schema_version": "6.0",
  "task": {
    "title": "单词地下城 Word Dungeon - 应试学生向单词战斗 Roguelike",
    "source_text": "想做一个背单词的游戏。经确认：目标玩家为应试学生（中高考/四六级/考研/雅思），核心玩法为单词战斗 Roguelike（答题即攻击，连击、技能、卡组构筑，单局5-10分钟），交付物为完整 GDD 飞书云文档 + 可玩 HTML 原型 Demo。",
    "readiness_target": "prototype",
    "flags": {
      "capacity": false,
      "handoff": true,
      "html": true,
      "lifecycle": true,
      "numbers": true,
      "persistence": true,
      "probability": true,
      "production": false,
      "resources": true,
      "scope_constraints": false
    }
  },
