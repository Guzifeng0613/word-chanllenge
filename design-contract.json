  "assumptions": [
    {
      "id": "ASM-TIME",
      "statement": "中等熟练玩家平均每题从读到答出约 5 秒，含战斗结算与节点操作平均每题约 7 秒",
      "impact": "high",
      "status": "test_value",
      "validation": "真人试玩校准；若实际均值超过 8 秒，下调敌人 HP 与每层节点数"
    },
    {
      "id": "ASM-ACCURACY",
      "statement": "同层词池复用条件下，普通战正确率约 85%，精英 85%，Boss 约 88%",
      "impact": "high",
      "status": "test_value",
      "validation": "试玩统计；若低于 80%，下调敌人攻击值或提高泉水恢复量"
    }
  ],
  "rules": [
    {
      "id": "RULE-TYPE-LADDER",
      "title": "题型阶梯（先认后背，拼写压轴）",
      "definition": "题型由每个单词的学习进度 step(0-3) 决定，不再随机：step0 初识 judge（单词+正确释义直接给出，确认见过）→ step1 英→中 en2cn（4选1）→ step2 中→英 cn2en（4选1）→ step3 拼写 spell（自由产出，压轴）。答对 step s<3 升一级（间隔 2/3/5 分钟），step3 拼写答对才毕业（graduated=true，进入 SM-2，10 分钟后首次复习）；答错 wrong_count+1、step 退回一级、短间隔重现。战斗中题干下方显示四格进阶（识→认→写→拼）。拼写仅限≤8字母，超长词降级 cn2en。毕业后复习题型按阶段交替：stage0 中→英(10分)、stage1 拼写(1天)、stage2 英→中(3天)、stage3 中→英(7天)、stage4 英→中(16天)、stage5 拼写(30天，通过即 MASTERED)。",
      "priority": "P0",
      "parameter_ids": [
