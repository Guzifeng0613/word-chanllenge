  "state_machines": [
    {
      "id": "SM-WORD-MEMORY",
      "initial_state": "NEW",
      "states": [
        {
          "id": "NEW",
          "entry": "词首次进入（step0 初识 judge，正确释义直接给）",
          "exit": "初识确认答对"
        },
        {
          "id": "LEARNING",
          "entry": "题型阶梯 step0-3：judge→en2cn→cn2en→spell",
          "exit": "step3 拼写答对毕业；答错退回一级（仍在 LEARNING）"
        },
        {
          "id": "FAMILIAR",
          "entry": "已毕业 SM-2 stage0-4，间隔 10分/1天/3天/7天/16天",
          "exit": "答对升阶段；答错 lapse 退回阶梯"
        },
        {
          "id": "MASTERED",
          "entry": "stage5，30 天复习通过，伤害 +40%",
          "exit": "终态；答错仍退回 LEARNING"
        }
      ],
      "event_order": [
        "answer",
        "theta_update",
        "stage_transition",
        "next_due_schedule"
      ],
      "transitions": [
        {
          "id": "TRIG-NEW-LEARN",
          "from": "NEW",
          "event": "初识 judge 答对",
          "to": "LEARNING",
          "effect": "step0→1，2 分钟后重现，theta +0.05",
          "repeat_policy": "同一题只结算一次",
          "cleanup": "记录 step 与 due"
        },
        {
          "id": "TRIG-LADDER-UP",
          "from": "LEARNING",
          "event": "step1/2 答对",
          "to": "LEARNING",
          "effect": "step 升一级，间隔 3/5 分钟重现",
          "repeat_policy": "到期前不重复",
          "cleanup": "更新 step/due"
        },
        {
          "id": "TRIG-LADDER-BACK",
          "from": "LEARNING",
          "event": "答错",
          "to": "LEARNING",
          "effect": "wrong_count+1，step 退回一级，短间隔重现",
          "repeat_policy": "到期最高优先级",
          "cleanup": "step 退回"
        },
        {
          "id": "TRIG-LADDER-GRADUATE",
          "from": "LEARNING",
          "event": "step3 拼写答对",
          "to": "FAMILIAR",
          "effect": "graduated=true，stage0，10 分钟后首次复习",
          "repeat_policy": "毕业唯一",
          "cleanup": "进入 SM-2"
        },
        {
          "id": "TRIG-FAM-UP",
          "from": "FAMILIAR",
          "event": "fast 答对或连续 2 次 normal 答对",
          "to": "FAMILIAR",
          "effect": "stage 升一级，按间隔梯安排",
          "repeat_policy": "到期前不重复",
          "cleanup": "更新 stage/streak"
        },
        {
          "id": "TRIG-FAM-MASTER",
          "from": "FAMILIAR",
          "event": "stage4 时 fast 答对或连续 2 次 normal 答对",
          "to": "MASTERED",
          "effect": "stage5，30 天，伤害 +40%",
          "repeat_policy": "不再主动出题",
          "cleanup": "更新掌握计数"
        },
        {
          "id": "TRIG-FAM-REGRESS",
          "from": "FAMILIAR",
          "event": "答错",
          "to": "LEARNING",
          "effect": "lapse：wrong_count+1、lapses+1、stage 清零、退回阶梯（首次 step2，多次 step1）",
          "repeat_policy": "到期最高优先级",
          "cleanup": "退出毕业、step 退回"
        },
        {
          "id": "TRIG-MASTER-REGRESS",
          "from": "MASTERED",
          "event": "答错",
          "to": "LEARNING",
          "effect": "lapse，退回阶梯",
          "repeat_policy": "到期最高优先级",
          "cleanup": "stage 清零"
        }
