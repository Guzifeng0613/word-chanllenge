  "numeric_requirements": [
    {
      "id": "NUMREQ-DPP",
      "statement": "无卡牌时中等玩家平均每题伤害应落在 13-16 区间，保证普通怪 2-4 题击杀",
      "source": "design_goal",
      "assertion_ids": [
        "ASSERT-DPP-BASE",
        "ASSERT-KILL-NORMAL"
      ]
    },
    {
      "id": "NUMREQ-DAMAGE",
      "statement": "一局（3层）总承伤应在 110-145，扣除 3 个泉水恢复 75 后净压力 35-70，使中等玩家无防御卡也能靠血药紧张通关",
      "source": "design_goal",
      "assertion_ids": [
        "ASSERT-DAMAGE-TOTAL",
        "ASSERT-NET-DAMAGE"
      ]
    },
    {
      "id": "NUMREQ-PACE",
      "statement": "一局总题数 60-80、总时长 9-13 分钟，符合应试学生碎片时间",
      "source": "design_goal",
      "assertion_ids": [
        "ASSERT-QUESTIONS",
        "ASSERT-TIME"
      ]
    },
    {
      "id": "NUMREQ-GOLD",
      "statement": "一局金币收入约 375，3 个商店每店可支配约 125，恰好花完不囤积",
      "source": "design_goal",
      "assertion_ids": [
        "ASSERT-GOLD",
        "ASSERT-GOLD-SPEND"
      ]
    }
  ],
